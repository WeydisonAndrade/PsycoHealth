// =============================================================================
// Schema Prisma — Modelo de dados do MVP PsycoHealth
// Define usuários, perfis, agendamentos, pagamentos (com comissão) e vídeo.
// Banco: SQLite em desenvolvimento (DATABASE_URL no .env)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Papéis de acesso na plataforma
enum UserRole {
  PATIENT       // Paciente que agenda consultas
  PSYCHOLOGIST  // Profissional que atende
  ADMIN         // Reservado para gestão futura
}

// Ciclo de vida de uma consulta agendada
enum AppointmentStatus {
  PENDING_PAYMENT // Criada, aguardando pagamento do paciente
  CONFIRMED       // Paga e confirmada
  IN_PROGRESS     // Paciente/psicólogo entraram na sala de vídeo
  COMPLETED       // Sessão encerrada
  CANCELLED       // Cancelada por paciente ou psicólogo
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// Conta base — autenticação compartilhada entre pacientes e psicólogos
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   // bcrypt — nunca armazenar senha em texto puro
  name         String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  psychologistProfile PsychologistProfile?
  patientProfile      PatientProfile?
}

// Dados profissionais exibidos no marketplace e no dashboard
model PsychologistProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  crp            String   @unique // Registro profissional (validado no cadastro)
  bio            String   @default("")
  specialties    String   @default("[]") // JSON serializado (SQLite não tem array nativo)
  sessionPrice   Float    @default(150)
  photoUrl       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability AvailabilitySlot[]
  appointments Appointment[]     @relation("PsychologistAppointments")
}

model PatientProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  phone     String?
  birthDate String?
  concerns  String?  // Problemas ou motivos relatados pelo paciente
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[] @relation("PatientAppointments")
}

// Grade semanal de atendimento — usada para calcular slots disponíveis
model AvailabilitySlot {
  id             String @id @default(cuid())
  psychologistId String
  dayOfWeek      Int    // 0=Domingo … 6=Sábado
  startTime      String // Formato "HH:mm"
  endTime        String

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId])
}

// Consulta entre um psicólogo e um paciente
model Appointment {
  id             String            @id @default(cuid())
  psychologistId String
  patientId      String
  scheduledAt    DateTime
  durationMin    Int               @default(50)
  status         AppointmentStatus @default(PENDING_PAYMENT)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  psychologist PsychologistProfile @relation("PsychologistAppointments", fields: [psychologistId], references: [id])
  patient      PatientProfile      @relation("PatientAppointments", fields: [patientId], references: [id])
  payment      Payment?
  videoSession VideoSession?

  @@index([psychologistId, scheduledAt])
  @@index([patientId])
}

// Pagamento vinculado à consulta — registra split 80/20 automaticamente
model Payment {
  id                 String        @id @default(cuid())
  appointmentId      String        @unique
  totalAmount        Float         // Valor pago pelo paciente
  platformCommission Float         // 20% retido pela plataforma
  psychologistPayout Float         // 80% repassado ao psicólogo
  commissionRate     Float         @default(0.20)
  status             PaymentStatus @default(PENDING)
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

// Sala de vídeo (Jitsi Meet) criada após confirmação do pagamento
model VideoSession {
  id            String    @id @default(cuid())
  appointmentId String    @unique
  roomId        String    @unique // Identificador usado na URL do Jitsi
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime  @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}
