{
  "name": "psycohealth",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "npm run build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
